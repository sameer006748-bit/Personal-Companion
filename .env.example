# Public Supabase browser configuration. Do not add a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_AGENT_V2_LLM_FIRST=1

# Set to 1 only to build on purpose without cloud config. Otherwise `vite build`
# fails when the two values above are missing, because a build without them
# ships an Assistant that can never leave the device.
VITE_ALLOW_LOCAL_ONLY_BUILD=
